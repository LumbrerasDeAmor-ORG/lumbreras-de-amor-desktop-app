---
// apps/desktop/src/layouts/Layout.astro
// Layout compartido: sidebar de navegación + topbar, replicando el look del demo.
import TitleBar from "../componentes/titlebar.astro";
import Icon from "../componentes/icon.astro";

interface Props {
  title: string;
  subtitle?: string;
  active:
    | "panel"
    | "mujeres"
    | "ninos"
    | "coordinadores"
    | "voluntarios"
    | "eventos"
    | "jornadas"
    | "donantes"
    | "diplomas"
    | "viveres"
    | "reportes";
}

const { title, subtitle, active } = Astro.props;

// Íconos outline (estilo Feather Icons), monocromáticos vía currentColor.
const icons = {
  home: '<path d="M3 10.5 12 3l9 7.5"/><path d="M5 9.5V21h14V9.5"/><path d="M9.5 21v-6h5v6"/>',
  users: '<circle cx="9" cy="8" r="3.2"/><path d="M2.5 20c0-3.3 2.9-6 6.5-6s6.5 2.7 6.5 6"/><path d="M16.5 8.2a3.2 3.2 0 0 1 0 6.3"/><path d="M17 14c2.8.4 5 2.4 5 5"/>',
  child: '<circle cx="12" cy="6" r="3"/><path d="M6 21c0-4 2.7-7 6-7s6 3 6 7"/><path d="M9 14v3"/><path d="M15 14v3"/>',
  coordinador: '<path d="M16 21v-2a4 4 0 0 0-4-4H6a4 4 0 0 0-4 4v2"/><circle cx="9" cy="7" r="4"/><polyline points="16 11 18 13 22 9"/>',
  calendar: '<rect x="3.5" y="5" width="17" height="15" rx="2"/><path d="M3.5 9.5h17"/><path d="M8 3v4"/><path d="M16 3v4"/>',
  organizar: '<rect x="3" y="4" width="18" height="16" rx="2"/><path d="M8 2v4"/><path d="M16 2v4"/><path d="M3 10h18"/><path d="M8 14h.01"/><path d="M12 14h.01"/><path d="M16 14h.01"/>',
  donantes: '<rect x="2.5" y="5" width="19" height="14" rx="2"/><path d="M2.5 10h19"/><path d="M7 15h4"/>',
  box: '<path d="M3.5 8 12 4l8.5 4-8.5 4-8.5-4Z"/><path d="M3.5 8v9L12 21l8.5-4V8"/><path d="M12 12v9"/>',
  heart: '<path d="M12 20.5S3.5 15.2 3.5 9.3C3.5 6.4 5.8 4 8.7 4c1.7 0 3.1.9 3.3 2.2C12.2 4.9 13.6 4 15.3 4c2.9 0 5.2 2.4 5.2 5.3 0 5.9-8.5 11.2-8.5 11.2Z"/>',
  file: '<path d="M6 3.5h8l4 4V20a1 1 0 0 1-1 1H6a1 1 0 0 1-1-1V4.5a1 1 0 0 1 1-1Z"/><path d="M14 3.5V8h4"/><path d="M8 13h8"/><path d="M8 17h8"/>',
  jornada: '<path d="M9 5H7a2 2 0 0 0-2 2v12a2 2 0 0 0 2 2h10a2 2 0 0 0 2-2V7a2 2 0 0 0-2-2h-2"/><rect x="9" y="3" width="6" height="4" rx="1"/><path d="M9 12h6"/><path d="M9 16h4"/>',
  diploma: '<circle cx="12" cy="9" r="6"/><path d="m8.6 14.2-1.6 7.3L12 18.6l5 2.9-1.6-7.3"/>',
  chevron: '<polyline points="6 9 12 15 18 9"/>',
} as const;

const topNavItems = [
  { key: "panel", label: "Panel General", href: "/", icon: icons.home },
  { key: "mujeres", label: "Mujeres", href: "/mujeres", icon: icons.users },
  { key: "ninos", label: "Niños", href: "/niños", icon: icons.child },
  { key: "coordinadores", label: "Coordinadores", href: "/coordinadores", icon: icons.coordinador },
  { key: "voluntarios", label: "Voluntarios", href: "/voluntarios", icon: icons.heart },
] as const;

const organizarSubItems = [
  { key: "eventos", label: "Eventos", href: "/eventos", icon: icons.calendar },
  { key: "jornadas", label: "Jornadas", href: "/jornadas", icon: icons.jornada },
] as const;

const bottomNavItems = [
  { key: "donantes", label: "Donantes", href: "/donantes", icon: icons.donantes },
  { key: "viveres", label: "Víveres Y Donaciones", href: "/viveres", icon: icons.box },
  { key: "diplomas", label: "Diplomas", href: "/diplomas", icon: icons.diploma },
  { key: "reportes", label: "Reportes Mensuales", href: "/reportes", icon: icons.file },
] as const;

const navBase =
  "group relative flex w-full items-center justify-between gap-2.5 rounded-lg px-3 py-2 text-[13.5px] font-medium transition-colors duration-150 focus-visible:outline-2 focus-visible:outline-accent-300";
const navIdle = "text-slate-400 hover:bg-white/5 hover:text-slate-100";
const navActive = "bg-white/10 text-white before:absolute before:inset-y-2 before:-left-3 before:w-[3px] before:rounded-r-full before:bg-accent-300";
const iconBase = "size-[18px] shrink-0 transition-colors";
const svgAttrs = { viewBox: "0 0 24 24", fill: "none", stroke: "currentColor", "stroke-width": "1.7", "stroke-linecap": "round", "stroke-linejoin": "round" } as const;
const sectionLabel = "px-3 pb-1.5 pt-4 text-[10.5px] font-semibold uppercase tracking-[0.08em] text-slate-500";

const isOrganizarActive = active === "eventos" || active === "jornadas";
---
<!doctype html>
<html lang="es">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title} · Lumbreras de Amor</title>
    <script is:inline>
      try { if (localStorage.getItem("sidebar_collapsed") === "1") document.documentElement.dataset.sidebar = "collapsed"; } catch {}
    </script>
    <style is:global>
      @import "../styles/global.css";
    </style>
  </head>
  <body>
    <TitleBar />
    <div class="flex min-h-0 flex-1 overflow-hidden print:block">
      <aside class="sidebar flex shrink-0 flex-col overflow-y-auto border-r border-white/5 bg-sidebar px-4 py-5 text-slate-300 print:hidden">
        <div class="sidebar-brand flex items-center gap-3 px-1 pb-5">
          <img src="/logo.png" alt="Lumbreras de Amor ONG" width="44" height="44" class="size-11 shrink-0 rounded-full shadow-lg shadow-black/40 ring-2 ring-white/10" />
          <div class="brand-text font-display text-[17px] font-semibold leading-tight tracking-tight text-white">Lumbreras de Amor</div>
        </div>

        <nav class="mt-1 flex flex-1 flex-col gap-0.5" aria-label="Navegación principal">
          <div class={`section-label ${sectionLabel}`}>General</div>
          {topNavItems.map((item) => (
            <a class={`${navBase} ${active === item.key ? navActive : navIdle}`} href={item.href} title={item.label} aria-current={active === item.key ? "page" : undefined}>
              <span class="flex items-center gap-3">
                <svg class={`${iconBase} ${active === item.key ? "text-accent-300" : "text-slate-500 group-hover:text-slate-300"}`} {...svgAttrs} set:html={item.icon} />
                <span class="nav-label">{item.label}</span>
              </span>
            </a>
          ))}

          <div class={`section-label ${sectionLabel}`}>Organización</div>
          <div class="flex flex-col gap-0.5">
            <button
              id="btn-organizar-toggle"
              type="button"
              class={`${navBase} cursor-pointer ${isOrganizarActive ? "text-white" : navIdle}`}
              aria-expanded={isOrganizarActive ? "true" : "false"}
              aria-controls="subnav-organizar"
              title="Organizar algo"
            >
              <span class="flex items-center gap-3">
                <svg class={`${iconBase} ${isOrganizarActive ? "text-accent-300" : "text-slate-500 group-hover:text-slate-300"}`} {...svgAttrs} set:html={icons.organizar} />
                <span class="nav-label">Organizar algo</span>
              </span>
              <svg class={`nav-chevron size-4 text-slate-500 transition-transform duration-200 ${isOrganizarActive ? "rotate-180" : ""}`} {...svgAttrs} set:html={icons.chevron} />
            </button>

            <div id="subnav-organizar" class={`ml-[1.35rem] flex flex-col gap-0.5 border-l border-white/10 pl-3 ${isOrganizarActive ? "" : "hidden"}`}>
              {organizarSubItems.map((sub) => (
                <a class={`${navBase} !py-1.5 text-[13px] ${active === sub.key ? navActive.replace("before:-left-3", "before:-left-[13px]") : navIdle}`} href={sub.href} title={sub.label} aria-current={active === sub.key ? "page" : undefined}>
                  <span class="flex items-center gap-3">
                    <svg class={`size-4 shrink-0 ${active === sub.key ? "text-accent-300" : "text-slate-500 group-hover:text-slate-300"}`} {...svgAttrs} set:html={sub.icon} />
                    <span class="nav-label">{sub.label}</span>
                  </span>
                </a>
              ))}
            </div>
          </div>

          <div class={`section-label ${sectionLabel}`}>Recursos</div>
          {bottomNavItems.map((item) => (
            <a class={`${navBase} ${active === item.key ? navActive : navIdle}`} href={item.href} title={item.label} aria-current={active === item.key ? "page" : undefined}>
              <span class="flex items-center gap-3">
                <svg class={`${iconBase} ${active === item.key ? "text-accent-300" : "text-slate-500 group-hover:text-slate-300"}`} {...svgAttrs} set:html={item.icon} />
                <span class="nav-label">{item.label}</span>
              </span>
            </a>
          ))}
        </nav>

        <button id="btn-sidebar-toggle" type="button" class={`${navBase} ${navIdle} mt-3 cursor-pointer border-t border-white/5 !rounded-none pt-3`} title="Contraer menú (Ctrl+B)" aria-label="Contraer o expandir menú" aria-expanded="true">
          <span class="flex items-center gap-3">
            <svg class={`sidebar-toggle-icon ${iconBase} text-slate-500 transition-transform duration-200`} {...svgAttrs}><polyline points="11 17 6 12 11 7"/><polyline points="18 17 13 12 18 7"/></svg>
            <span class="nav-label">Contraer menú</span>
          </span>
        </button>
      </aside>

      <div class="flex min-h-0 min-w-0 flex-1 flex-col">
        <header class="z-10 flex min-h-[68px] shrink-0 py-2.5 items-center justify-between gap-4 border-b border-slate-200 bg-white/85 px-8 backdrop-blur print:hidden">
          <div class="min-w-0">
            <h1 id="page-title" class="font-display truncate text-[21px] font-semibold tracking-tight text-brand-700">{title}</h1>
            {subtitle && <p id="page-subtitle" class="mt-0.5 line-clamp-2 text-[13px] leading-snug text-slate-500">{subtitle}</p>}
          </div>
          <div class="topbar-actions flex shrink-0 items-center gap-2.5">
            <slot name="actions" />
          </div>
        </header>
        <main class="min-h-0 flex-1 overflow-auto px-8 py-7 print:overflow-visible print:p-0" style="zoom: var(--content-zoom);">
          <div class="mx-auto w-full max-w-[1400px]">
            <slot />
          </div>
        </main>
      </div>
    </div>

    <script>
      // Toggle para la sección "Organizar algo" en el sidebar
      const btnOrganizar = document.getElementById("btn-organizar-toggle");
      const subnavOrganizar = document.getElementById("subnav-organizar");

      btnOrganizar?.addEventListener("click", () => {
        const isOpen = btnOrganizar.getAttribute("aria-expanded") !== "true";
        btnOrganizar.setAttribute("aria-expanded", String(isOpen));
        subnavOrganizar?.classList.toggle("hidden", !isOpen);
        btnOrganizar.querySelector(".nav-chevron")?.classList.toggle("rotate-180", isOpen);
      });

      // Contraer / expandir sidebar (solo íconos)
      const btnSidebar = document.getElementById("btn-sidebar-toggle");
      function setSidebar(collapsed: boolean) {
        if (collapsed) document.documentElement.dataset.sidebar = "collapsed";
        else delete document.documentElement.dataset.sidebar;
        btnSidebar?.setAttribute("aria-expanded", String(!collapsed));
        btnSidebar?.setAttribute("title", collapsed ? "Expandir menú (Ctrl+B)" : "Contraer menú (Ctrl+B)");
        try { localStorage.setItem("sidebar_collapsed", collapsed ? "1" : "0"); } catch {}
      }
      const toggleSidebar = () => setSidebar(document.documentElement.dataset.sidebar !== "collapsed");
      btnSidebar?.addEventListener("click", toggleSidebar);
      window.addEventListener("keydown", (e) => {
        if ((e.ctrlKey || e.metaKey) && e.key.toLowerCase() === "b") { e.preventDefault(); toggleSidebar(); }
      });
      btnSidebar?.setAttribute("aria-expanded", String(document.documentElement.dataset.sidebar !== "collapsed"));

      // Control de zoom desacoplado estilo VS Code:
      // Se intercepta el zoom global del navegador/webview para mantener
      // la barra de título y el sidebar fijos al 100%, escalando únicamente el contenido.
      let nivelZoom = 1;

      function aplicarZoom(nuevoZoom: number) {
        nivelZoom = Math.min(Math.max(nuevoZoom, 0.75), 1.6);
        document.documentElement.style.setProperty("--content-zoom", nivelZoom.toString());
        try {
          localStorage.setItem("app_content_zoom", nivelZoom.toString());
        } catch {}
      }

      try {
        const guardado = localStorage.getItem("app_content_zoom");
        if (guardado) {
          const valor = parseFloat(guardado);
          if (!isNaN(valor)) aplicarZoom(valor);
        }
      } catch {}

      window.addEventListener("keydown", (e) => {
        if (e.ctrlKey || e.metaKey) {
          if (e.key === "+" || e.key === "=") {
            e.preventDefault();
            aplicarZoom(nivelZoom + 0.1);
          } else if (e.key === "-") {
            e.preventDefault();
            aplicarZoom(nivelZoom - 0.1);
          } else if (e.key === "0") {
            e.preventDefault();
            aplicarZoom(1);
          }
        }
      });

      window.addEventListener(
        "wheel",
        (e) => {
          if (e.ctrlKey || e.metaKey) {
            e.preventDefault();
            aplicarZoom(nivelZoom + (e.deltaY < 0 ? 0.05 : -0.05));
          }
        },
        { passive: false }
      );
    </script>
  </body>
</html>
