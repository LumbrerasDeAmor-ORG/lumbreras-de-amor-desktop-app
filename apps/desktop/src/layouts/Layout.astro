---
// apps/desktop/src/layouts/Layout.astro
// Layout compartido: sidebar de navegación + topbar, replicando el look del demo.
import TitleBar from "../componentes/titlebar.astro";
import Icon from "../componentes/icon.astro";

interface Props {
  title: string;
  subtitle?: string;
  active: "panel" | "mujeres" | "ninos" | "eventos" | "viveres" | "voluntarios" | "reportes";
}

const { title, subtitle, active } = Astro.props;

// Íconos outline (estilo Feather Icons), monocromáticos vía currentColor.
const icons = {
  home: '<path d="M3 10.5 12 3l9 7.5"/><path d="M5 9.5V21h14V9.5"/><path d="M9.5 21v-6h5v6"/>',
  users: '<circle cx="9" cy="8" r="3.2"/><path d="M2.5 20c0-3.3 2.9-6 6.5-6s6.5 2.7 6.5 6"/><path d="M16.5 8.2a3.2 3.2 0 0 1 0 6.3"/><path d="M17 14c2.8.4 5 2.4 5 5"/>',
  child: '<circle cx="12" cy="6" r="3"/><path d="M6 21c0-4 2.7-7 6-7s6 3 6 7"/><path d="M9 14v3"/><path d="M15 14v3"/>',
  calendar: '<rect x="3.5" y="5" width="17" height="15" rx="2"/><path d="M3.5 9.5h17"/><path d="M8 3v4"/><path d="M16 3v4"/>',
  box: '<path d="M3.5 8 12 4l8.5 4-8.5 4-8.5-4Z"/><path d="M3.5 8v9L12 21l8.5-4V8"/><path d="M12 12v9"/>',
  heart: '<path d="M12 20.5S3.5 15.2 3.5 9.3C3.5 6.4 5.8 4 8.7 4c1.7 0 3.1.9 3.3 2.2C12.2 4.9 13.6 4 15.3 4c2.9 0 5.2 2.4 5.2 5.3 0 5.9-8.5 11.2-8.5 11.2Z"/>',
  file: '<path d="M6 3.5h8l4 4V20a1 1 0 0 1-1 1H6a1 1 0 0 1-1-1V4.5a1 1 0 0 1 1-1Z"/><path d="M14 3.5V8h4"/><path d="M8 13h8"/><path d="M8 17h8"/>',
} as const;

const navItems = [
  { key: "panel", label: "Panel General", href: "/", icon: icons.home },
  { key: "mujeres", label: "Mujeres", href: "/mujeres", icon: icons.users },
  { key: "ninos", label: "Niños", href: "/niños", icon: icons.child },
  { key: "eventos", label: "Eventos & Asistencia", href: "/eventos", icon: icons.calendar },
  { key: "viveres", label: "Víveres & Donaciones", href: "/viveres", icon: icons.box },
  { key: "voluntarios", label: "Equipo de Voluntarios", href: "/voluntarios", icon: icons.heart },
  { key: "reportes", label: "Reportes Mensuales", href: "/reportes", icon: icons.file },
] as const;
---

<html lang="es">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title} · Lumbreras de Amor</title>
    <style is:global>
      :root {
        --sidebar-bg: #0b1120;
        --sidebar-fg: #cbd5e1;
        --sidebar-active-bg: #0d9488;
        --sidebar-active-fg: #ffffff;
        --content-bg: #f4f6f8;
        --card-bg: #ffffff;
        --card-border: #e5e7eb;
        --text-main: #111827;
        --text-muted: #6b7280;
        --accent: #0d9488;
        --accent-dark: #0f766e;
        --badge-alta-bg: #fef3c7;
        --badge-alta-fg: #92400e;
        --badge-media-bg: #dbeafe;
        --badge-media-fg: #1e40af;
        --badge-baja-bg: #dcfce7;
        --badge-baja-fg: #166534;
        --font-sans: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, Helvetica, Arial, sans-serif;
      }
      * { box-sizing: border-box; margin: 0; padding: 0; }
      body {
        font-family: var(--font-sans);
        background: var(--content-bg);
        color: var(--text-main);
        display: flex;
        flex-direction: column;
        height: 100vh;
        overflow: hidden;
      }
      .shell { flex: 1; display: flex; min-height: 0; }

      /* Sidebar */
      .sidebar {
        width: 250px;
        flex-shrink: 0;
        background: var(--sidebar-bg);
        color: var(--sidebar-fg);
        display: flex;
        flex-direction: column;
        padding: 1.25rem 0.9rem;
        overflow-y: auto;
      }
      .brand {
        display: flex;
        align-items: center;
        gap: 0.6rem;
        padding: 0 0.4rem 1.25rem 0.4rem;
        margin-bottom: 0.75rem;
        border-bottom: 1px solid #1f2937;
      }
      .brand-icon {
        width: 34px; height: 34px;
        border-radius: 8px;
        background: var(--accent);
        display: flex; align-items: center; justify-content: center;
        font-size: 1.1rem;
      }
      .brand-name { font-weight: 700; font-size: 0.95rem; color: #fff; line-height: 1.1; }
      .brand-sub { font-size: 0.68rem; color: var(--accent); letter-spacing: 0.02em; }

      .context-pill {
        display: flex; align-items: center; justify-content: space-between;
        background: #111827;
        border-radius: 8px;
        padding: 0.5rem 0.7rem;
        font-size: 0.78rem;
        margin-bottom: 0.75rem;
      }
      .context-pill .status { color: var(--accent); font-weight: 600; font-size: 0.68rem; }

      nav { display: flex; flex-direction: column; gap: 0.2rem; flex: 1; }
      .nav-item {
        display: flex; align-items: center; justify-content: space-between;
        gap: 0.6rem;
        padding: 0.6rem 0.7rem;
        border-radius: 8px;
        color: var(--sidebar-fg);
        text-decoration: none;
        font-size: 0.86rem;
        transition: background-color 0.12s;
      }
      .nav-item:hover { background: #111827; }
      .nav-item.active {
        background: var(--sidebar-active-bg);
        color: var(--sidebar-active-fg);
        font-weight: 600;
      }
      .nav-item .label { display: flex; align-items: center; gap: 0.55rem; }
      .nav-icon { width: 17px; height: 17px; flex-shrink: 0; opacity: 0.85; }
      .nav-badge {
        background: rgba(255,255,255,0.18);
        border-radius: 999px;
        font-size: 0.68rem;
        padding: 0.05rem 0.45rem;
      }

      .sidebar-footer {
        margin-top: 0.75rem;
        background: #111827;
        border-radius: 10px;
        padding: 0.75rem;
        font-size: 0.72rem;
        color: var(--text-muted);
      }
      .sidebar-footer strong { color: #fff; display: block; margin-bottom: 0.2rem; }

      /* Main area */
      .main { flex: 1; display: flex; flex-direction: column; min-width: 0; min-height: 0; }
      .topbar {
        display: flex; align-items: center; justify-content: space-between;
        padding: 1.1rem 1.75rem;
        background: var(--card-bg);
        border-bottom: 1px solid var(--card-border);
      }
      .topbar h1 { font-size: 1.15rem; font-weight: 700; }
      .topbar p { font-size: 0.8rem; color: var(--text-muted); margin-top: 0.15rem; }
      .topbar-actions { display: flex; align-items: center; gap: 0.6rem; }
      .btn {
        border: none; border-radius: 8px; padding: 0.5rem 0.9rem;
        font-size: 0.82rem; font-weight: 600; cursor: pointer;
      }
      .btn-primary { background: var(--accent); color: #fff; }
      .btn-primary:hover { background: var(--accent-dark); }
      .btn-ghost { background: #f3f4f6; color: var(--text-main); }

      .content { flex: 1; padding: 1.5rem 1.75rem; overflow-y: auto; }

      /* Reusable card / grid pieces used across pages */
      .card {
        background: var(--card-bg);
        border: 1px solid var(--card-border);
        border-radius: 12px;
        padding: 1.1rem;
      }
      .grid {
        display: grid;
        grid-template-columns: repeat(auto-fill, minmax(260px, 1fr));
        gap: 1rem;
      }
      .badge {
        display: inline-block;
        border-radius: 999px;
        font-size: 0.7rem;
        font-weight: 600;
        padding: 0.15rem 0.55rem;
      }
      .badge-alta { background: var(--badge-alta-bg); color: var(--badge-alta-fg); }
      .badge-media { background: var(--badge-media-bg); color: var(--badge-media-fg); }
      .badge-baja { background: var(--badge-baja-bg); color: var(--badge-baja-fg); }

      @media print {
        body { display: block; height: auto; overflow: visible; }
        .shell, .main { display: block; }
        .sidebar, .topbar { display: none; }
        .content { padding: 0; overflow: visible; }
      }
    </style>
  </head>
  <body>
    <TitleBar />
    <div class="shell">
    <aside class="sidebar">
      <div class="brand">
        <div class="brand-icon"><Icon name="heart" size={18} /></div>
        <div>
          <div class="brand-name">Lumbreras de Amor</div>
          <div class="brand-sub">ONG &amp; IMPACTO SOCIAL</div>
        </div>
      </div>

      <div class="context-pill">
        <span>Gestión Integral 2026</span>
        <span class="status">Activo</span>
      </div>

      <nav>
        {navItems.map((item) => (
          <a class={`nav-item ${active === item.key ? "active" : ""}`} href={item.href}>
            <span class="label">
              <svg class="nav-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" set:html={item.icon} />
              {item.label}
            </span>
          </a>
        ))}
      </nav>

      <div class="sidebar-footer">
        <strong>Lumbreras de Amor</strong>
        Plataforma para seguimiento de mujeres, niños, asistencia, víveres y donaciones.
      </div>
    </aside>

    <div class="main">
      <header class="topbar">
        <div>
          <h1>{title}</h1>
          {subtitle && <p>{subtitle}</p>}
        </div>
        <div class="topbar-actions">
          <slot name="actions" />
        </div>
      </header>
      <main class="content">
        <slot />
      </main>
    </div>
    </div>
  </body>
</html>