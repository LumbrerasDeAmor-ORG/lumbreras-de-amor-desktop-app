---
// apps/desktop/src/pages/coordinadores/index.astro
import Layout from "../../layouts/Layout.astro";
import Icon from "../../componentes/icon.astro";
import { getCoordinadores, getEventos, getJornadas } from "../../lib/mockData";

const [rawCoordinadores, eventos, jornadas] = await Promise.all([
  getCoordinadores(),
  getEventos(),
  getJornadas(),
]);

const coordinadores = rawCoordinadores.map((c) => {
  if (c.nombres && c.apellidos) return c;
  const partes = (c.nombre || "").trim().split(/\s+/);
  const mitad = Math.max(1, Math.ceil(partes.length / 2));
  return {
    ...c,
    nombres: c.nombres || partes.slice(0, mitad).join(" "),
    apellidos: c.apellidos || partes.slice(mitad).join(" "),
  };
});

const totalActividadesCoordinadas = eventos.length + jornadas.length;
---

<Layout
  title="Coordinadores de Programas y Actividades"
  subtitle="Responsables de dirección, supervisión logística y coordinación de eventos y jornadas comunitarias"
  active="coordinadores"
>
  <div slot="actions">
    <a href="/eventos/nuevo"><button class="btn btn-ghost" type="button">+ Asignar en Evento</button></a>
    <a href="/voluntarios"><button class="btn btn-ghost" type="button">Ver Equipo de Voluntarios</button></a>
    <a href="/coordinadores/nuevo"><button class="btn btn-primary" type="button">+ Nuevo Coordinador</button></a>
  </div>

  <div class="grid" style="margin-bottom: 1.2rem;">
    <div class="card">
      <div style="font-size:0.75rem; color:var(--text-muted);">Coordinadores Activos</div>
      <div style="font-size:1.6rem; font-weight:700; color:var(--accent);">{coordinadores.length} Coordinadores</div>
    </div>
    <div class="card">
      <div style="font-size:0.75rem; color:var(--text-muted);">Eventos Y Jornadas Supervisadas</div>
      <div style="font-size:1.6rem; font-weight:700;">{totalActividadesCoordinadas} Actividades</div>
    </div>
    <div class="card">
      <div style="font-size:0.75rem; color:var(--text-muted);">Horas de Coordinación</div>
      <div style="font-size:1.6rem; font-weight:700;">
        {coordinadores.reduce((acc, c) => acc + c.horasAcumuladas, 0)} Horas
      </div>
    </div>
  </div>

  <div class="card" style="margin-bottom: 1.1rem; display:flex; gap:0.8rem; align-items:center; flex-wrap:wrap;">
    <input
      id="buscar-coord"
      type="search"
      placeholder="Buscar coordinador por nombres, apellidos, área o especialidad..."
      style="flex: 1; min-width: 240px; padding: 0.5rem 0.75rem; border: 1px solid var(--card-border); border-radius: 8px; font-size: 0.85rem;"
    />
    <span id="contador-coord" style="font-size:0.8rem; color:var(--text-muted);">
      Mostrando {coordinadores.length} coordinadores habilitados
    </span>
  </div>

  <div id="grid-coordinadores" class="grid">
    {coordinadores.map((c) => {
      const nombreCompleto = `${c.nombres} ${c.apellidos}`.trim();
      const eventosAsignados = eventos.filter((e) => e.coordinador === c.nombre || e.coordinador === nombreCompleto);
      const jornadasAsignadas = jornadas.filter((j) => j.coordinador === c.nombre || j.coordinador === nombreCompleto);
      const actividades = [
        ...eventosAsignados.map((e) => ({ tipo: "Evento", titulo: e.titulo })),
        ...jornadasAsignadas.map((j) => ({ tipo: "Jornada", titulo: j.titulo })),
      ];
      return (
        <article
          class="person-card coord-card"
          data-nombre={nombreCompleto.toLowerCase()}
          data-especialidad={c.especialidad.toLowerCase()}
        >
          <div class="person-head">
            <div class="avatar">{`${(c.nombres ?? "")[0] ?? ""}${(c.apellidos ?? "")[0] ?? ""}`.toUpperCase()}</div>
            <div class="min-w-0 flex-1">
              <h3 class="person-name">{nombreCompleto}</h3>
              <p class="person-sub">{c.especialidad}</p>
            </div>
          </div>

          <ul class="info-list">
            <li><span class="ico-wrap"><Icon name="mail" /></span><span class="truncate-line" title={c.email}>{c.email || "—"}</span></li>
            <li><span class="ico-wrap"><Icon name="phone" /></span><span class="tabular-nums">{c.telefono || "—"}</span></li>
            <li><span class="ico-wrap"><Icon name="clock" /></span><span>{c.disponibilidad}</span></li>
          </ul>

          <div class="mt-4 border-t border-slate-100 pt-4">
            <p class="text-xs font-semibold text-slate-900">
              Actividades a su cargo <span class="font-normal text-slate-500">({actividades.length})</span>
            </p>
            {actividades.length === 0 ? (
              <p class="mt-1.5 text-xs text-slate-500">Disponible para próxima asignación</p>
            ) : (
              <ul class="mt-2 flex flex-col gap-1.5">
                {actividades.slice(0, 3).map((a) => (
                  <li class="flex items-baseline gap-2 text-xs text-slate-600">
                    <span class="w-14 shrink-0 text-[10.5px] font-semibold uppercase tracking-wide text-slate-400">{a.tipo}</span>
                    <span class="truncate" title={a.titulo}>{a.titulo}</span>
                  </li>
                ))}
                {actividades.length > 3 && <li class="text-xs text-slate-400">+ {actividades.length - 3} más</li>}
              </ul>
            )}
          </div>

          <div class="card-foot">
            <span>Horas de coordinación <strong>{c.horasAcumuladas} h</strong></span>
          </div>

          <div class="card-actions">
            <a href={`/coordinadores/nuevo?id=${c.id}`} class="btn btn-ghost">Editar</a>
          </div>
        </article>
      );
    })}
  </div>
</Layout>

<script>
  const inputBuscar = document.getElementById("buscar-coord") as HTMLInputElement | null;
  const contador = document.getElementById("contador-coord");
  const grid = document.getElementById("grid-coordinadores");

  try {
    const rawLocal = localStorage.getItem("lumbreras_coordinadores_creados");
    const locales: Array<Record<string, any>> = rawLocal ? JSON.parse(rawLocal) : [];
    const existentes = new Set(
      Array.from(document.querySelectorAll<HTMLElement>(".coord-card")).map(
        (c) => c.dataset.nombre ?? ""
      )
    );
    for (const item of locales) {
      const full = `${item.nombres ?? ""} ${item.apellidos ?? ""}`.trim();
      if (full && !existentes.has(full.toLowerCase())) {
        const card = document.createElement("div");
        card.className = "card coord-card";
        card.dataset.nombre = full.toLowerCase();
        card.dataset.especialidad = String(item.especialidad || "Coordinador").toLowerCase();
        card.innerHTML = `
          <div style="display:flex; justify-content:space-between; align-items:flex-start; gap:0.5rem;">
            <div>
              <div style="font-weight:700; font-size:0.95rem;">${full}</div>
              <span class="badge badge-media" style="margin-top:0.25rem;">${item.especialidad || "Coordinador General"}</span>
            </div>
            <span class="badge badge-curso">Coordinador ONG</span>
          </div>
          <div style="margin-top:0.75rem; font-size:0.78rem; display:flex; flex-direction:column; gap:0.28rem;">
            <span>${item.email || "coordinador@lumbrerasdeamor.org"}</span>
            <span>${item.telefono || "+502 0000 0000"}</span>
            <span>Disponibilidad: ${item.disponibilidad || "Tiempo completo"}</span>
          </div>
          <div style="margin-top:0.75rem; padding-top:0.65rem; border-top:1px solid var(--card-border); font-size:0.76rem;">
            <strong style="display:block; margin-bottom:0.35rem; color:var(--text-main);">
              Actividades bajo su coordinación (0):
            </strong>
            <span style="color:var(--text-muted);">Disponible para próxima asignación</span>
          </div>
        `;
        grid?.prepend(card);
        existentes.add(full.toLowerCase());
      }
    }
  } catch {}

  inputBuscar?.addEventListener("input", () => {
    const cards = Array.from(document.querySelectorAll<HTMLElement>(".coord-card"));
    const q = inputBuscar.value.trim().toLowerCase();
    let visibles = 0;
    for (const card of cards) {
      const nom = card.dataset.nombre ?? "";
      const esp = card.dataset.especialidad ?? "";
      const match = !q || nom.includes(q) || esp.includes(q);
      card.style.display = match ? "" : "none";
      if (match) visibles++;
    }
    if (contador) {
      contador.textContent = `Mostrando ${visibles} de ${cards.length} coordinadores habilitados`;
    }
  });
</script>
