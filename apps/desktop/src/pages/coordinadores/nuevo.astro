---
// apps/desktop/src/pages/coordinadores/nuevo.astro
import Layout from "../../layouts/Layout.astro";
---

<Layout
  title="Nuevo Coordinador de Programa"
  subtitle="Registro formal de coordinador responsable de dirección, supervisión logística y coordinación de eventos y jornadas"
  active="coordinadores"
>
  <div slot="actions">
    <a href="/coordinadores"><button class="btn btn-ghost" type="button">← Volver al listado</button></a>
  </div>

  <form id="form-coordinador" class="card" style="max-width: 640px;" novalidate>
    <div class="form-grid">
      <label>
        Nombres *
        <input name="nombres" type="text" placeholder="Ej: Laura Camila" required />
      </label>
      <label>
        Apellidos *
        <input name="apellidos" type="text" placeholder="Ej: Ortiz Gómez" required />
      </label>
      <label>
        DPI
        <input
          id="dpi-coordinador"
          name="dpi"
          type="text"
          inputmode="numeric"
          maxlength="13"
          pattern="[0-9]{13}"
          title="El DPI debe tener 13 dígitos"
          placeholder="13 dígitos, sin espacios"
        />
      </label>
      <label>
        Teléfono *
        <input name="telefono" type="tel" placeholder="+502 5315 1098" required />
      </label>
      <label>
        Correo *
        <input name="email" type="email" placeholder="coordinador@lumbrerasdeamor.org" required />
      </label>
      <label>
        Especialidad / Área de Coordinación *
        <input name="especialidad" type="text" placeholder="Ej: Coordinador de Salud Comunitaria" required />
      </label>
      <label>
        Horas acumuladas iniciales
        <input name="horasAcumuladas" type="number" min="0" value="0" />
      </label>
      <label>
        Disponibilidad
        <select name="disponibilidad">
          <option value="Tiempo completo">Tiempo completo</option>
          <option value="Fines de semana">Fines de semana</option>
          <option value="Tardes">Tardes</option>
          <option value="Flexible">Flexible</option>
        </select>
      </label>
    </div>

    <p id="form-error" style="display:none; color:#b91c1c; font-size:0.8rem; margin-top:0.8rem;">
      Completá los campos obligatorios (*) antes de continuar.
    </p>

    <div style="margin-top:1.1rem; display:flex; gap:0.6rem;">
      <button class="btn btn-primary" type="submit">Guardar Coordinador</button>
      <button class="btn btn-ghost" type="reset">Limpiar</button>
    </div>
  </form>

  <div id="preview" class="card" style="display:none; max-width: 640px; margin-top: 1.2rem;">
    <strong id="preview-title" style="font-size:0.85rem; color:#166534;">✔ Coordinador guardado en la base de datos SQLite local</strong>
    <pre id="preview-content" style="margin-top:0.7rem; font-size:0.78rem; background:#f4f6f8; padding:0.8rem; border-radius:8px; white-space:pre-wrap;"></pre>
    <div style="margin-top:0.8rem;">
      <a href="/coordinadores"><button class="btn btn-primary" type="button">Ir al listado de Coordinadores</button></a>
    </div>
  </div>
</Layout>

<style>
  .form-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 0.9rem;
  }
  .form-grid label {
    display: flex;
    flex-direction: column;
    gap: 0.3rem;
    font-size: 0.8rem;
    font-weight: 600;
    color: var(--text-main);
  }
  .form-grid input,
  .form-grid select {
    font-weight: 400;
    padding: 0.5rem 0.6rem;
    border: 1px solid var(--card-border);
    border-radius: 8px;
    font-size: 0.85rem;
  }
</style>

<script>
  const form = document.getElementById("form-coordinador") as HTMLFormElement | null;
  const errorEl = document.getElementById("form-error");
  const preview = document.getElementById("preview");
  const previewTitle = document.getElementById("preview-title");
  const previewContent = document.getElementById("preview-content");
  const dpiInput = document.getElementById("dpi-coordinador") as HTMLInputElement | null;

  dpiInput?.addEventListener("input", () => {
    dpiInput.value = dpiInput.value.replace(/\D/g, "");
  });

  form?.addEventListener("submit", async (e) => {
    e.preventDefault();

    if (!form.checkValidity()) {
      if (errorEl) {
        errorEl.textContent = "Completá los campos obligatorios (*) antes de continuar.";
        errorEl.style.display = "block";
      }
      form.reportValidity();
      return;
    }
    if (errorEl) errorEl.style.display = "none";

    const data = Object.fromEntries(new FormData(form).entries());
    const nombres = String(data.nombres ?? "").trim();
    const apellidos = String(data.apellidos ?? "").trim();
    const payload = {
      nombres,
      apellidos,
      nombre_completo: `${nombres} ${apellidos}`.trim(),
      dpi: String(data.dpi ?? "").trim(),
      telefono: String(data.telefono ?? "").trim(),
      email: String(data.email ?? "").trim(),
      especialidad: String(data.especialidad ?? "").trim(),
      rol_especialidad: String(data.especialidad ?? "").trim(),
      horas_acumuladas: Number(data.horasAcumuladas) || 0,
      horasAcumuladas: Number(data.horasAcumuladas) || 0,
      disponibilidad: String(data.disponibilidad ?? "Tiempo completo").trim(),
      tipo: "Propio",
      tipo_voluntario: "Propio",
    };

    let savedRecord: Record<string, unknown> = payload;

    try {
      const res = await fetch("http://127.0.0.1:4111/coordinadores", {
        method: "POST",
        headers: { "Content-Type": "application/json" },
        body: JSON.stringify(payload),
      });
      const result = await res.json();
      if (res.ok && result.success) {
        savedRecord = result.data;
      }
    } catch {
      // Fallback local si el Sidecar está offline
    }

    try {
      const rawPrev = localStorage.getItem("lumbreras_coordinadores_creados");
      const list = rawPrev ? JSON.parse(rawPrev) : [];
      list.unshift(payload);
      localStorage.setItem("lumbreras_coordinadores_creados", JSON.stringify(list));
    } catch {}

    if (preview && previewContent) {
      if (previewTitle) {
        previewTitle.textContent = `✔ Coordinador guardado (${nombres} ${apellidos})`;
      }
      previewContent.textContent = JSON.stringify(savedRecord, null, 2);
      preview.style.display = "block";
      preview.scrollIntoView({ behavior: "smooth", block: "nearest" });
    }
    form.reset();
  });
</script>
