---
// apps/desktop/src/pages/eventos/nuevo.astro
import Layout from "../../layouts/Layout.astro";
---

<Layout
  title="Nuevo Evento"
  subtitle="Registro y planificación de celebraciones, talleres y actividades comunitarias"
  active="eventos"
>
  <div slot="actions">
    <a href="/eventos"><button class="btn btn-ghost" type="button">← Volver a Eventos</button></a>
  </div>

  <form id="form-evento" class="card" style="max-width: 640px;" novalidate>
    <div class="form-grid">
      <label style="grid-column: 1 / -1;">
        Título del evento *
        <input name="titulo" type="text" placeholder="Ej: Convivio Día de la Familia" required />
      </label>

      <label>
        Categoría *
        <select name="categoria" required>
          <option value="">Seleccionar...</option>
          <option value="Celebración">Celebración</option>
          <option value="Recaudación de Fondos">Recaudación de Fondos</option>
          <option value="Capacitación">Capacitación</option>
          <option value="Taller Comunitario">Taller Comunitario</option>
          <option value="Integración Familiar">Integración Familiar</option>
        </select>
      </label>

      <label>
        Estado *
        <select name="estado" required>
          <option value="Planificado" selected>Planificado</option>
          <option value="Finalizado">Finalizado</option>
        </select>
      </label>

      <label>
        Fecha *
        <input name="fecha" type="date" required />
      </label>

      <label>
        Horario *
        <input name="horario" type="text" placeholder="Ej: 14:00 - 18:00" required />
      </label>

      <label style="grid-column: 1 / -1;">
        Ubicación / Lugar *
        <input name="ubicacion" type="text" placeholder="Ej: Sede Lumbreras de Amor, Salón Comunal..." required />
      </label>

      <label>
        Coordinador responsable *
        <input name="coordinador" type="text" placeholder="Ej: Lic. Laura Camila Ortiz" required />
      </label>

      <label>
        Presupuesto estimado (GTQ)
        <input name="presupuestoTotal" type="number" min="0" step="0.01" placeholder="Ej: 500" />
      </label>

      <label>
        Meta de asistentes (convocados)
        <input name="convocados" type="number" min="0" placeholder="Ej: 40" />
      </label>

      <label>
        Voluntarios asignados
        <input name="voluntariosAsignados" type="number" min="0" placeholder="Ej: 6" />
      </label>

      <label style="grid-column: 1 / -1;">
        Descripción y objetivos del evento
        <textarea
          name="descripcion"
          rows="3"
          placeholder="Detalla las actividades planeadas, público objetivo y requerimientos logísticos..."
        ></textarea>
      </label>
    </div>

    <p id="form-error" style="display:none; color:#b91c1c; font-size:0.8rem; margin-top:0.8rem;">
      Completá los campos obligatorios (*) antes de continuar.
    </p>

    <div style="margin-top:1.1rem; display:flex; gap:0.6rem;">
      <button class="btn btn-primary" type="submit">Guardar Evento</button>
      <button class="btn btn-ghost" type="reset">Limpiar</button>
    </div>
  </form>

  <div id="preview" class="card" style="display:none; max-width: 640px; margin-top: 1.2rem;">
    <strong style="font-size:0.85rem;">Vista previa del evento (aún no se guarda en ningún lado — esto es solo UI)</strong>
    <pre id="preview-content" style="margin-top:0.7rem; font-size:0.78rem; background:#f4f6f8; padding:0.8rem; border-radius:8px; white-space:pre-wrap;"></pre>
  </div>
</Layout>

<style>
  .form-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 0.9rem;
  }
  .form-grid label {
    display: flex;
    flex-direction: column;
    gap: 0.3rem;
    font-size: 0.8rem;
    font-weight: 600;
    color: var(--text-main);
  }
  .form-grid input,
  .form-grid select,
  .form-grid textarea {
    font-weight: 400;
    padding: 0.5rem 0.6rem;
    border: 1px solid var(--card-border);
    border-radius: 8px;
    font-size: 0.85rem;
    font-family: inherit;
  }
</style>

<script>
  const form = document.getElementById("form-evento") as HTMLFormElement | null;
  const errorEl = document.getElementById("form-error");
  const preview = document.getElementById("preview");
  const previewContent = document.getElementById("preview-content");

  form?.addEventListener("submit", (e) => {
    e.preventDefault();

    if (!form.checkValidity()) {
      if (errorEl) errorEl.style.display = "block";
      form.reportValidity();
      return;
    }
    if (errorEl) errorEl.style.display = "none";

    const data = Object.fromEntries(new FormData(form).entries());
    if (preview && previewContent) {
      previewContent.textContent = JSON.stringify(data, null, 2);
      preview.style.display = "block";
      preview.scrollIntoView({ behavior: "smooth", block: "nearest" });
    }
  });
</script>
