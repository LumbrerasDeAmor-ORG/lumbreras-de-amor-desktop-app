---
// apps/desktop/src/pages/index.astro
// El diagnóstico técnico original (sidecar/DB) se movió a /diagnostico.
import Layout from "../layouts/Layout.astro";
import { getMujeres, getNinos, getEventos, getResumenReporte } from "../lib/mockData";

const [mujeres, ninos, eventos, resumen] = await Promise.all([
  getMujeres(),
  getNinos(),
  getEventos(),
  getResumenReporte(),
]);

const prioritarios = [...mujeres.filter((m) => m.nota), ...ninos.filter((n) => n.alergia)];
const eventosPlanificados = eventos.filter((e) => e.estado === "Planificado");
---

<Layout title="Panel General de Impacto" subtitle="Resumen en tiempo real de mujeres, niños, eventos y recursos" active="panel">
  <div class="grid" style="margin-bottom: 1.2rem;">
    <div class="card">
      <div style="font-size:0.72rem; color:var(--text-muted);">Mujeres Registradas</div>
      <div style="font-size:1.6rem; font-weight:700;">{mujeres.length}</div>
    </div>
    <div class="card">
      <div style="font-size:0.72rem; color:var(--text-muted);">Niños Registrados</div>
      <div style="font-size:1.6rem; font-weight:700;">{ninos.length}</div>
    </div>
    <div class="card">
      <div style="font-size:0.72rem; color:var(--text-muted);">Eventos Planificados</div>
      <div style="font-size:1.6rem; font-weight:700;">{eventosPlanificados.length}</div>
    </div>
    <div class="card">
      <div style="font-size:0.72rem; color:var(--text-muted);">Fondos Recaudados</div>
      <div style="font-size:1.6rem; font-weight:700;">${resumen.fondosRecaudados}</div>
    </div>
  </div>

  <h3 style="font-size:0.95rem; margin-bottom:0.6rem;">Perfiles con Seguimiento Prioritario</h3>
  <p style="font-size:0.78rem; color:var(--text-muted); margin-bottom:0.8rem;">Mujeres y niños con alertas médicas, nutricionales o de vulnerabilidad alta</p>

  <div class="grid">
    {prioritarios.map((p) => (
      <div class="card">
        <div style="font-weight:700; font-size:0.9rem;">{"nota" in p ? p.nombre : p.nombre}</div>
        <div style="margin-top:0.6rem; background:#fef3c7; color:#92400e; font-size:0.75rem; padding:0.4rem 0.6rem; border-radius:6px;">
          ⚠️ {"nota" in p ? p.nota : p.alergia}
        </div>
      </div>
    ))}
  </div>
</Layout>