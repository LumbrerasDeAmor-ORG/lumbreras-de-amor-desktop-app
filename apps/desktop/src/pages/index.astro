---
// apps/desktop/src/pages/index.astro
// El diagnóstico técnico original (sidecar/DB) se movió a /diagnostico.
import Layout from "../layouts/Layout.astro";
import Icon from "../componentes/icon.astro";
import { getMujeres, getNinos, getEventos, getJornadas, getResumenReporte } from "../lib/mockData";
import { formatQ } from "../lib/currency";

const [mujeres, ninos, eventos, jornadas, resumen] = await Promise.all([
  getMujeres(),
  getNinos(),
  getEventos(),
  getJornadas(),
  getResumenReporte(),
]);

// Lista unificada: cada elemento tiene nombre y motivo, sin importar si viene de Mujer o Nino.
const prioritarios: { id: string; nombre: string; motivo: string }[] = [
  ...mujeres.flatMap((m) => (m.nota ? [{ id: m.id, nombre: `${m.nombres} ${m.apellidos}`, motivo: m.nota }] : [])),
  ...ninos.flatMap((n) => (n.observaciones ? [{ id: n.id, nombre: `${n.nombres} ${n.apellidos}`, motivo: n.observaciones }] : [])),
];
const eventosActivos = eventos.filter((e) => e.estado === "Planificado" || e.estado === "En curso");
const jornadasActivas = jornadas.filter((j) => j.estado === "Planificado" || j.estado === "En curso");
---

<Layout title="Panel General de Impacto" subtitle="Resumen en tiempo real de mujeres, niños, eventos y recursos" active="panel">
  <div class="grid" style="margin-bottom: 1.2rem;">
    <div class="card">
      <div style="font-size:0.72rem; color:var(--text-muted);">Mujeres Registradas</div>
      <div style="font-size:1.6rem; font-weight:700;">{mujeres.length}</div>
    </div>
    <div class="card">
      <div style="font-size:0.72rem; color:var(--text-muted);">Niños Registrados</div>
      <div style="font-size:1.6rem; font-weight:700;">{ninos.length}</div>
    </div>
    <div class="card">
      <div style="font-size:0.72rem; color:var(--text-muted);">Jornadas Planificadas / En Curso</div>
      <div style="font-size:1.6rem; font-weight:700;">{jornadasActivas.length}</div>
    </div>
    <div class="card">
      <div style="font-size:0.72rem; color:var(--text-muted);">Eventos Planificados / En Curso</div>
      <div style="font-size:1.6rem; font-weight:700;">{eventosActivos.length}</div>
    </div>
    <div class="card">
      <div style="font-size:0.72rem; color:var(--text-muted);">Fondos Recaudados</div>
      <div style="font-size:1.6rem; font-weight:700; color:var(--accent);">{formatQ(resumen.fondosRecaudados)}</div>
    </div>
  </div>

  <h3 style="font-size:0.95rem; margin-bottom:0.6rem;">Perfiles con Seguimiento Prioritario</h3>
  <p style="font-size:0.78rem; color:var(--text-muted); margin-bottom:0.8rem;">Mujeres y niños con alertas médicas, nutricionales o de vulnerabilidad alta</p>

  <div class="grid">
    {prioritarios.map((p) => (
      <div class="card">
        <div style="font-weight:700; font-size:0.9rem;">{p.nombre}</div>
        <div style="margin-top:0.6rem; background:#fef3c7; color:#92400e; font-size:0.75rem; padding:0.4rem 0.6rem; border-radius:6px;">
          <Icon name="alert" /> {p.motivo}
        </div>
      </div>
    ))}
  </div>
</Layout>