---
// apps/desktop/src/pages/jornadas/index.astro
import Layout from "../../layouts/Layout.astro";
import Icon from "../../componentes/icon.astro";
import { getJornadas } from "../../lib/mockData";

const jornadas = await getJornadas();
---

<Layout title="Jornadas Comunitarias" subtitle="Jornadas de salud, comedores comunitarios y entregas de kits en terreno" active="jornadas">
  <div slot="actions">
    <a href="/jornadas/nuevo"><button class="btn btn-primary" type="button">+ Crear Jornada</button></a>
  </div>

  <div class="grid">
    {jornadas.map((jornada) => (
      <div class="card">
        <div style="display:flex; gap:0.4rem; margin-bottom:0.5rem;">
          <span class={`badge ${jornada.estado === "Finalizado" ? "badge-baja" : "badge-media"}`}>{jornada.estado}</span>
          <span class="badge badge-media">{jornada.categoria}</span>
          <span class="badge badge-baja">{jornada.servicios.length} servicios</span>
        </div>
        <div style="font-weight:700; font-size:0.95rem;">{jornada.titulo}</div>
        <p style="font-size:0.8rem; color:var(--text-muted); margin-top:0.4rem;">{jornada.descripcion}</p>

        <div style="margin-top:0.75rem; font-size:0.78rem; display:flex; flex-direction:column; gap:0.25rem;">
          <span><Icon name="calendar" /> {jornada.fecha} · {jornada.horario}</span>
          <span><Icon name="pin" /> {jornada.ubicacion}</span>
          <span><Icon name="user" /> Coord: {jornada.coordinador}</span>
          <span><Icon name="dollar" /> Presupuesto: ${jornada.presupuestoEjecutado} / ${jornada.presupuestoTotal}</span>
        </div>

        <div style="margin-top:0.8rem;">
          <div style="display:flex; justify-content:space-between; font-size:0.75rem; color:var(--text-muted);">
            <span>Asistencia Confirmada</span>
            <span>{jornada.asistieron} de {jornada.convocados} ({Math.round((jornada.asistieron / jornada.convocados) * 100)}%)</span>
          </div>
          <div style="background:#e5e7eb; border-radius:999px; height:6px; margin-top:0.3rem;">
            <div style={`background:var(--accent); height:6px; border-radius:999px; width:${Math.round((jornada.asistieron / jornada.convocados) * 100)}%;`}></div>
          </div>
        </div>

        <div style="margin-top:0.8rem; display:flex; justify-content:space-between; align-items:center;">
          <span style="font-size:0.75rem; color:var(--text-muted);">{jornada.voluntariosAsignados} voluntarios asignados</span>
          <a href={`/jornadas/${jornada.id}`}><button class="btn btn-primary" type="button">Ver Jornada</button></a>
        </div>
      </div>
    ))}
  </div>
</Layout>