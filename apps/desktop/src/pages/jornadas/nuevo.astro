---
// apps/desktop/src/pages/jornadas/nuevo.astro
import Layout from "../../layouts/Layout.astro";
import { CATEGORIAS_JORNADA, getCoordinadores, getVoluntarios } from "../../lib/mockData";

const [coordinadores, voluntarios] = await Promise.all([
  getCoordinadores(),
  getVoluntarios(),
]);
---

<Layout
  title="Nueva Jornada Comunitaria"
  subtitle="Planificación de jornadas médicas, dentales, entregas de víveres, juguetes, vestimenta y alimentos servidos"
  active="jornadas"
>
  <div slot="actions">
    <a href="/jornadas"><button class="btn btn-ghost" type="button">← Volver a Jornadas</button></a>
  </div>

  <form id="form-jornada" class="card" style="max-width: 700px;" novalidate>
    <div class="form-grid">
      <label style="grid-column: 1 / -1;">
        Título de la jornada *
        <input name="titulo" type="text" placeholder="Ej: Gran Jornada Multidisciplinaria de Salud y Nutrición" required />
      </label>

      <label>
        Categoría de jornada *
        <select name="categoria" required>
          <option value="">Seleccionar...</option>
          {CATEGORIAS_JORNADA.map((cat) => (
            <option value={cat}>{cat}</option>
          ))}
        </select>
      </label>

      <label>
        Estado *
        <select name="estado" required>
          <option value="Planificado" selected>Planificado</option>
          <option value="En curso">En curso</option>
          <option value="Finalizado">Finalizado</option>
        </select>
      </label>

      <label>
        Fecha *
        <input name="fecha" type="date" required />
      </label>

      <label>
        Horario *
        <input name="horario" type="text" placeholder="Ej: 08:30 - 13:30" required />
      </label>

      <label style="grid-column: 1 / -1;">
        Ubicación / Sede de atención *
        <input name="ubicacion" type="text" placeholder="Ej: Centro Comunitario San Jerónimo (Villa Esperanza)" required />
      </label>

      <label>
        Coordinador general *
        <select name="coordinador" required>
          <option value="">Seleccionar coordinador...</option>
          {coordinadores.map((c) => (
            <option value={c.nombre}>{c.nombre} — {c.especialidad}</option>
          ))}
        </select>
      </label>

      <label>
        Presupuesto estimado (Q)
        <input name="presupuestoTotal" type="number" min="0" step="0.01" placeholder="Ej: 1200.00" />
      </label>

      <label>
        Convocados estimados
        <input name="convocados" type="number" min="0" placeholder="Ej: 50" />
      </label>

      <label>
        Voluntarios asignados (Equipo de Voluntarios)
        <select name="voluntariosAsignadosNombres" multiple size="3" title="Mantené presionado Ctrl para seleccionar varios">
          {voluntarios.map((v) => (
            <option value={`${v.nombre} (${v.tipo})`}>{v.nombre} — {v.tipo} ({v.especialidad})</option>
          ))}
        </select>
      </label>

      <label style="grid-column: 1 / -1;">
        Descripción general de la jornada
        <textarea
          name="descripcion"
          rows="2"
          placeholder="Resumen del impacto, beneficiarios prioritarios y logística requerida..."
        ></textarea>
      </label>

      <div style="grid-column: 1 / -1; margin-top: 0.5rem;">
        <div style="display:flex; justify-content:space-between; align-items:center; margin-bottom:0.5rem;">
          <strong style="font-size:0.85rem;">Servicios de la Jornada</strong>
          <button id="btn-add-servicio" class="btn btn-ghost" type="button" style="font-size:0.75rem; padding:0.3rem 0.6rem;">
            + Agregar Servicio
          </button>
        </div>

        <div id="lista-servicios" style="display:flex; flex-direction:column; gap:0.6rem;">
          <div class="servicio-fila card" style="padding:0.7rem; background:#f9fafb;">
            <div style="display:grid; grid-template-columns: 1fr 1fr; gap:0.5rem;">
              <input name="servicio_nombre[]" type="text" placeholder="Nombre del servicio (Ej: Consulta médica general)" required />
              <input name="servicio_responsable[]" type="text" placeholder="Responsable (Ej: Dra. Carolina Méndez)" required />
            </div>
            <input name="servicio_descripcion[]" type="text" placeholder="Breve descripción del servicio" style="margin-top:0.4rem; width:100%;" />
          </div>
        </div>
      </div>
    </div>

    <p id="form-error" style="display:none; color:#b91c1c; font-size:0.8rem; margin-top:0.8rem;">
      Completá los campos obligatorios (*) antes de continuar.
    </p>

    <div style="margin-top:1.1rem; display:flex; gap:0.6rem;">
      <button class="btn btn-primary" type="submit">Guardar Jornada</button>
      <button class="btn btn-ghost" type="reset">Limpiar</button>
    </div>
  </form>

  <div id="preview" class="card" style="display:none; max-width: 700px; margin-top: 1.2rem;">
    <strong style="font-size:0.85rem; color:#166534;">✔ Jornada registrada correctamente</strong>
    <pre id="preview-content" style="margin-top:0.7rem; font-size:0.78rem; background:#f4f6f8; padding:0.8rem; border-radius:8px; white-space:pre-wrap;"></pre>
    <div style="margin-top:0.8rem;">
      <a href="/jornadas"><button class="btn btn-primary" type="button">Volver al listado de Jornadas</button></a>
    </div>
  </div>
</Layout>

<style>
  .form-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 0.9rem;
  }
  .form-grid label {
    display: flex;
    flex-direction: column;
    gap: 0.3rem;
    font-size: 0.8rem;
    font-weight: 600;
    color: var(--text-main);
  }
  .form-grid input,
  .form-grid select,
  .form-grid textarea {
    font-weight: 400;
    padding: 0.5rem 0.6rem;
    border: 1px solid var(--card-border);
    border-radius: 8px;
    font-size: 0.85rem;
    font-family: inherit;
  }
</style>

<script>
  const form = document.getElementById("form-jornada") as HTMLFormElement | null;
  const errorEl = document.getElementById("form-error");
  const preview = document.getElementById("preview");
  const previewContent = document.getElementById("preview-content");
  const btnAddServicio = document.getElementById("btn-add-servicio");
  const listaServicios = document.getElementById("lista-servicios");

  btnAddServicio?.addEventListener("click", () => {
    if (!listaServicios) return;
    const item = document.createElement("div");
    item.className = "servicio-fila card";
    item.style.cssText = "padding:0.7rem; background:#f9fafb;";
    item.innerHTML = `
      <div style="display:grid; grid-template-columns: 1fr 1fr; gap:0.5rem;">
        <input name="servicio_nombre[]" type="text" placeholder="Nombre del servicio" required />
        <input name="servicio_responsable[]" type="text" placeholder="Responsable" required />
      </div>
      <input name="servicio_descripcion[]" type="text" placeholder="Breve descripción del servicio" style="margin-top:0.4rem; width:100%;" />
    `;
    listaServicios.appendChild(item);
  });

  form?.addEventListener("submit", async (e) => {
    e.preventDefault();

    if (!form.checkValidity()) {
      if (errorEl) errorEl.style.display = "block";
      form.reportValidity();
      return;
    }
    if (errorEl) errorEl.style.display = "none";

    const formData = new FormData(form);
    const nombres = formData.getAll("servicio_nombre[]");
    const responsables = formData.getAll("servicio_responsable[]");
    const descripciones = formData.getAll("servicio_descripcion[]");
    const voluntariosSeleccionados = formData.getAll("voluntariosAsignadosNombres").map(String);

    const servicios = nombres.map((nom, i) => ({
      nombre: nom,
      responsable: responsables[i] ?? "",
      descripcion: descripciones[i] ?? "",
    }));

    const data: Record<string, unknown> = Object.fromEntries(formData.entries());
    delete data["servicio_nombre[]"];
    delete data["servicio_responsable[]"];
    delete data["servicio_descripcion[]"];
    delete data["voluntariosAsignadosNombres"];

    const montoNum = parseFloat(String(data.presupuestoTotal || "0")) || 0;
    data.presupuestoTotal = Number(montoNum.toFixed(2));
    data.presupuestoFormateado = `Q ${montoNum.toLocaleString("en-US", { minimumFractionDigits: 2, maximumFractionDigits: 2 })}`;
    data.voluntariosAsignados = voluntariosSeleccionados.length;
    data.voluntariosNombres = voluntariosSeleccionados;
    data.servicios = servicios;

    try {
      const res = await fetch("http://127.0.0.1:4111/jornadas", {
        method: "POST",
        headers: { "Content-Type": "application/json" },
        body: JSON.stringify(data),
      });

      const result = await res.json();
      if (!res.ok || !result.success) {
        throw new Error(result.error || "No se pudo guardar la jornada en SQLite");
      }

      if (preview && previewContent) {
        previewContent.textContent = JSON.stringify(result.data, null, 2);
        preview.style.display = "block";
        preview.scrollIntoView({ behavior: "smooth", block: "nearest" });
      }
      form.reset();
    } catch (err) {
      if (errorEl) {
        errorEl.textContent = `Error al guardar en base de datos: ${(err as Error).message}`;
        errorEl.style.display = "block";
      }
    }
  });
</script>
