---
// apps/desktop/src/pages/mujeres/index.astro
import Layout from "../../layouts/Layout.astro";
import Icon from "../../componentes/icon.astro";
import { getMujeres } from "../../lib/mockData";

const mujeres = await getMujeres();

const tonoFuente: Record<string, string> = {
  desempleada: "tag-warn",
  "vendedora informal": "tag-info",
  asalariada: "tag-ok",
  dependiente: "tag-info",
  "asalariada y dependiente": "tag-ok",
};
---

<Layout
  title="Perfiles de Mujeres"
  subtitle="Datos personales, hogar, programas y seguimiento integral"
  active="mujeres"
>
  <div slot="actions">
    <a href="/mujeres/nuevo" class="btn btn-primary">+ Nuevo perfil</a>
  </div>

  <div class="toolbar">
    <input id="buscador" type="text" placeholder="Buscar por nombres, apellidos o colonia..." />
    <select id="filtro-fuentes-ingreso">
      <option value="">Todas las fuentes de ingreso</option>
      <option value="desempleada">desempleada</option>
      <option value="vendedora informal">vendedora informal</option>
      <option value="asalariada">asalariada</option>
      <option value="dependiente">dependiente</option>
      <option value="asalariada y dependiente">asalariada y dependiente</option>
    </select>
  </div>

  <p id="contador" class="mb-4 text-[13px] font-medium text-slate-500">
    Mostrando {mujeres.length} de {mujeres.length} perfiles registrados
  </p>

  <div class="grid" id="lista-mujeres">
    {mujeres.map((mujer) => (
      <article
        class="person-card mujer-card"
        data-nombre={`${mujer.nombres} ${mujer.apellidos}`.toLowerCase()}
        data-colonia={mujer.colonia.toLowerCase()}
        data-fuentes-ingreso={mujer.fuentesDeIngreso}
      >
        <div class="person-head">
          <div class="avatar">
            {`${mujer.nombres[0] ?? ""}${mujer.apellidos[0] ?? ""}`.toUpperCase()}
          </div>
          <div class="min-w-0 flex-1">
            <h3 class="person-name">{mujer.nombres} {mujer.apellidos}</h3>
            <p class="person-sub">{mujer.codigo} · {mujer.edad} años</p>
          </div>
        </div>
        <span class={`tag mt-3 ${tonoFuente[mujer.fuentesDeIngreso] ?? "tag-info"}`}>{mujer.fuentesDeIngreso}</span>

        <ul class="info-list">
          <li><span class="ico-wrap"><Icon name="home" /></span><span>{mujer.colonia} <span class="text-slate-400">({mujer.direccion})</span></span></li>
          <li><span class="ico-wrap"><Icon name="phone" /></span><span class="tabular-nums">{mujer.telefono}</span></li>
          <li><span class="ico-wrap"><Icon name="child" /></span><span>{mujer.hijosACargo} hijo(s) a cargo</span></li>
          <li><span class="ico-wrap"><Icon name="briefcase" /></span><span>{mujer.ocupacion}</span></li>
        </ul>

        {mujer.nota && (
          <div class="card-note">
            <Icon name="alert" /> <span>{mujer.nota}</span>
          </div>
        )}

        <div class="card-actions mt-auto pt-5">
          <a href={`/mujeres/${mujer.id}`} class="btn btn-ghost">Ver perfil</a>
          <a href={`/mujeres/nuevo?id=${mujer.id}`} class="btn btn-ghost">Editar</a>
        </div>
      </article>
    ))}
  </div>

  <p id="sin-resultados" class="hidden py-12 text-center text-sm text-slate-500">
    No se encontraron perfiles con esos criterios.
  </p>
</Layout>

<script>
  // Filtro/búsqueda en cliente sobre las tarjetas ya renderizadas (US-05).
  const buscador = document.getElementById("buscador") as HTMLInputElement | null;
  const filtroFuentes = document.getElementById("filtro-fuentes-ingreso") as HTMLSelectElement | null;
  const tarjetas = Array.from(document.querySelectorAll<HTMLElement>(".mujer-card"));
  const contador = document.getElementById("contador");
  const sinResultados = document.getElementById("sin-resultados");
  const total = tarjetas.length;

  function aplicarFiltros() {
    const texto = (buscador?.value ?? "").trim().toLowerCase();
    const fuente = filtroFuentes?.value ?? "";
    let visibles = 0;

    for (const card of tarjetas) {
      const nombre = card.dataset.nombre ?? "";
      const colonia = card.dataset.colonia ?? "";
      const coincideTexto = !texto || nombre.includes(texto) || colonia.includes(texto);
      const coincideFuentes = !fuente || card.dataset.fuentesIngreso === fuente;
      const visible = coincideTexto && coincideFuentes;
      card.style.display = visible ? "" : "none";
      if (visible) visibles++;
    }

    if (contador) contador.textContent = `Mostrando ${visibles} de ${total} perfiles registrados`;
    if (sinResultados) sinResultados.classList.toggle("hidden", visibles !== 0);
  }

  buscador?.addEventListener("input", aplicarFiltros);
  filtroFuentes?.addEventListener("change", aplicarFiltros);
</script>