---
// apps/desktop/src/pages/mujeres/nuevo.astro
import Layout from "../../layouts/Layout.astro";
import Icon from "../../componentes/icon.astro";
---

<Layout
  title="Nuevo Perfil de Mujer"
  subtitle="Registro de datos personales, hogar y programas"
  active="mujeres"
>
  <div slot="actions">
    <a href="/mujeres"><button class="btn btn-ghost" type="button">← Volver al listado</button></a>
  </div>

  <form id="form-mujer" class="form-card" novalidate>
    <div class="form-card-header">
      <div class="form-card-icon"><Icon name="users" size={20} /></div>
      <div>
        <h2 class="form-card-title">Datos de la mujer</h2>
        <p class="form-card-desc">Información personal, hogar y programas en los que participa. Los campos con * son obligatorios.</p>
      </div>
    </div>
    <div class="form-card-body">
    <div class="form-grid">
      <label>
        Nombres *
        <input name="nombres" type="text" required />
      </label>
      <label>
        Apellidos *
        <input name="apellidos" type="text" required />
      </label>
      <label>
        DPI
        <input
          id="dpi-mujer"
          name="dpi"
          type="text"
          inputmode="numeric"
          maxlength="13"
          pattern="[0-9]{13}"
          title="El DPI debe tener 13 dígitos"
          placeholder="13 dígitos, sin espacios"
        />
      </label>
      <label>
        Edad *
        <input name="edad" type="number" min="0" max="120" required />
      </label>
      <label>
        Dirección *
        <input name="direccion" type="text" required />
      </label>
      <label>
        Colonia *
        <input name="colonia" type="text" required />
      </label>
      <label>
        Teléfono
        <input name="telefono" type="tel" />
      </label>
      <label>
        Ocupación
        <input name="ocupacion" type="text" />
      </label>
      <label>
        Estado civil *
        <select name="estadoCivil" required>
          <option value="">Seleccionar...</option>
          <option value="Soltera">Soltera</option>
          <option value="Madre soltera">Madre soltera</option>
          <option value="Casada">Casada</option>
          <option value="Unión libre">Unión libre</option>
          <option value="Viuda">Viuda</option>
        </select>
      </label>
      <label>
        Tercera edad
        <select name="terceraEdad">
          <option value="No">No</option>
          <option value="Sí">Sí</option>
        </select>
      </label>
      <label>
        Hijos a cargo
        <input name="hijosACargo" type="number" min="0" value="0" />
      </label>
      <label>
        Fuentes de ingreso
        <select name="fuentesDeIngreso">
          <option value="">Seleccionar...</option>
          <option value="desempleada">desempleada</option>
          <option value="vendedora informal">vendedora informal</option>
          <option value="asalariada">asalariada</option>
          <option value="dependiente">dependiente</option>
          <option value="asalariada y dependiente">asalariada y dependiente</option>
        </select>
      </label>
      <label style="grid-column: 1 / -1;">
        Programas / Talleres (separados por coma)
        <input name="programas" type="text" placeholder="Ej: Taller de Costura, Nutrición Familiar" />
      </label>
      <label style="grid-column: 1 / -1;">
        Problemas sociales (separados por coma)
        <input name="problemasSociales" type="text" placeholder="Ej: Violencia intrafamiliar, Desempleo" />
      </label>
    </div>

    <p id="form-error" class="form-error" style="display:none;">
      Completá los campos obligatorios (*) antes de continuar.
    </p>

    </div>


    <div class="form-card-footer">
      <button class="btn btn-primary" type="submit">Guardar Perfil</button>
      <button class="btn btn-ghost" type="reset">Limpiar</button>
    </div>
  </form>

  <div id="preview" class="card" style="display:none; max-width: 640px; margin-top: 1.2rem;">
    <strong id="preview-title" style="font-size:0.85rem; color:#166534;">✔ Perfil guardado en la base de datos SQLite local</strong>
    <pre id="preview-content" style="margin-top:0.7rem; font-size:0.78rem; background:#f4f6f8; padding:0.8rem; border-radius:8px; white-space:pre-wrap;"></pre>
    <div style="margin-top:0.8rem;">
      <a href="/mujeres"><button class="btn btn-primary" type="button">Ir al listado de Mujeres</button></a>
    </div>
  </div>
</Layout>

<style>
  .form-grid label {
    display: flex;
    flex-direction: column;
    gap: 0.3rem;
    font-size: 0.8rem;
    font-weight: 600;
    color: var(--text-main);
  }
</style>

<script>
  import { idEdicion, cargarParaEditar, guardarEdicion, llenarFormulario, activarModoEdicion, mostrarError, SIDECAR_URL } from "../../lib/edicion";
  const form = document.getElementById("form-mujer") as HTMLFormElement | null;
  const errorEl = document.getElementById("form-error");
  const preview = document.getElementById("preview");
  const previewTitle = document.getElementById("preview-title");
  const previewContent = document.getElementById("preview-content");
  const dpiInput = document.getElementById("dpi-mujer") as HTMLInputElement | null;

  dpiInput?.addEventListener("input", () => {
    dpiInput.value = dpiInput.value.replace(/\D/g, "");
  });

  const editId = idEdicion();
  if (editId && form) {
    activarModoEdicion(form, {
      titulo: "Editar perfil de mujer",
      subtitulo: "Actualización de datos personales, hogar y programas",
      descripcion: "Modificá la información y guardá los cambios.",
      botonGuardar: "Guardar cambios",
      volverHref: `/mujeres/${editId}`,
    });
    cargarParaEditar("mujeres", editId)
      .then((m) =>
        llenarFormulario(form, {
          ...m,
          programas: (m.programas ?? []).join(", "),
          problemasSociales: (m.problemasSociales ?? []).join(", "),
        })
      )
      .catch((err) => {
        mostrarError(errorEl, `No se pudo cargar el perfil: ${(err as Error).message}`);
        form.querySelector<HTMLButtonElement>('button[type="submit"]')?.setAttribute("disabled", "true");
      });
  }

  form?.addEventListener("submit", async (e) => {
    e.preventDefault();

    if (!form.checkValidity()) {
      if (errorEl) {
        errorEl.textContent = "Completá los campos obligatorios (*) antes de continuar.";
        errorEl.style.display = "block";
      }
      form.reportValidity();
      return;
    }
    if (errorEl) errorEl.style.display = "none";

    const data = Object.fromEntries(new FormData(form).entries());
    if (editId) {
      try {
        await guardarEdicion("mujeres", editId, data);
        window.location.href = `/mujeres/${editId}`;
      } catch (err) {
        mostrarError(errorEl, `Error al guardar los cambios: ${(err as Error).message}`);
      }
      return;
    }
    try {
      const res = await fetch("http://127.0.0.1:4111/mujeres", {
        method: "POST",
        headers: { "Content-Type": "application/json" },
        body: JSON.stringify(data),
      });
      const result = await res.json();
      if (!res.ok || !result.success) {
        throw new Error(result.error || "No se pudo guardar el perfil en SQLite");
      }

      if (preview && previewContent) {
        if (previewTitle) {
          previewTitle.textContent = `✔ Perfil guardado en SQLite (${result.data.codigo})`;
        }
        previewContent.textContent = JSON.stringify(result.data, null, 2);
        preview.style.display = "block";
        preview.scrollIntoView({ behavior: "smooth", block: "nearest" });
      }
      form.reset();
    } catch (err) {
      if (errorEl) {
        errorEl.textContent = `Error al guardar en base de datos: ${(err as Error).message}`;
        errorEl.style.display = "block";
      }
    }
  });
</script>