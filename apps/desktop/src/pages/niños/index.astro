---
// apps/desktop/src/pages/ninos/index.astro
import Layout from "../../layouts/Layout.astro";
import Icon from "../../componentes/icon.astro";
import { getNinos, getMujeres } from "../../lib/mockData";

const [ninos, mujeres] = await Promise.all([getNinos(), getMujeres()]);
const mujerPorId = new Map(mujeres.map((m) => [m.id, m]));
---

<Layout
  title="Niños"
  subtitle="Perfiles vinculados a la mujer/madre o tutora responsable"
  active="ninos"\n>

  <div slot="actions">
  <a href="/niños/nuevo"><button class="btn btn-primary" type="button">+ Nuevo Niño</button></a>
  </div>
  
  <p style="color: var(--text-muted); font-size: 0.85rem; margin-bottom: 1rem;">
    Mostrando {ninos.length} de {ninos.length} niños registrados
  </p>

  <div class="grid">
    {ninos.map((nino) => {
      const madre = mujerPorId.get(nino.mujerId);
      return (
        <article class="person-card">
          <div class="person-head">
            <div class="avatar">{`${(nino.nombres ?? "")[0] ?? ""}${(nino.apellidos ?? "")[0] ?? ""}`.toUpperCase()}</div>
            <div class="min-w-0 flex-1">
              <h3 class="person-name">{nino.nombres} {nino.apellidos}</h3>
              <p class="person-sub">{nino.codigo} · {nino.edad} años</p>
            </div>
          </div>

          <ul class="info-list">
            <li><span class="ico-wrap"><Icon name="school" /></span><span>{nino.escolaridad || "Sin dato de escolaridad"}</span></li>
            <li><span class="ico-wrap"><Icon name="shirt" /></span><span>Camisa {nino.tallaCamisa ?? "—"} · Pantalón {nino.tallaPantalon ?? "—"} · Calzado {nino.tallaCalzado ?? "—"}</span></li>
            {madre && (
              <li><span class="ico-wrap"><Icon name="user" /></span><a href={`/mujeres/${madre.id}`} class="font-medium text-brand-700 hover:underline">{madre.nombres} {madre.apellidos}</a></li>
            )}
          </ul>

          {nino.observaciones && (
            <div class="card-note"><Icon name="alert" /> <span>{nino.observaciones}</span></div>
          )}

          <div class="card-actions mt-auto pt-5">
            <a href={`/niños/nuevo?id=${nino.id}`} class="btn btn-ghost">Editar</a>
          </div>
        </article>
      );
    })}
  </div>
</Layout>