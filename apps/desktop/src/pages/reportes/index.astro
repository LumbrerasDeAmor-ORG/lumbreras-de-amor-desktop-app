---
// apps/desktop/src/pages/reportes/index.astro
import Layout from "../../layouts/Layout.astro";
import Icon from "../../componentes/icon.astro";
import { getResumenReporte, getEventos, getDonaciones } from "../../lib/mockData";

const [resumen, eventos, donaciones] = await Promise.all([
  getResumenReporte(),
  getEventos(),
  getDonaciones(),
]);
---

<Layout title="Reportes Mensuales Automatizados" subtitle="Informes ejecutivos listos para benefactores, donantes y comités directivos" active="reportes">
  <div slot="actions">
    <button id="btn-csv" class="btn btn-ghost" type="button"><Icon name="download" /> Descargar CSV</button>
    <button id="btn-pdf" class="btn btn-primary" type="button"><Icon name="printer" /> Imprimir / Guardar PDF</button>
  </div>

  <p id="estado-export" class="estado-export" role="status"></p>

  <div
    id="reporte"
    class="card"
    style="max-width: 900px;"
    data-reporte={JSON.stringify({ resumen, eventos, donaciones })}
  >
    <h2 style="font-size:1.1rem;">Informe Mensual de Impacto &amp; Gestión Social</h2>
    <p style="font-size:0.8rem; color:var(--text-muted);">Período: {resumen.periodo}</p>

    <div class="grid" style="margin-top:1rem;">
      <div class="card"><div style="font-size:0.72rem; color:var(--text-muted);">Beneficiarios Atendidos</div><div style="font-size:1.4rem; font-weight:700;">{resumen.beneficiariosAtendidos}</div></div>
      <div class="card"><div style="font-size:0.72rem; color:var(--text-muted);">Eventos Realizados</div><div style="font-size:1.4rem; font-weight:700;">{resumen.eventosRealizados}</div></div>
      <div class="card"><div style="font-size:0.72rem; color:var(--text-muted);">Fondos Recaudados</div><div style="font-size:1.4rem; font-weight:700;">${resumen.fondosRecaudados}</div></div>
      <div class="card"><div style="font-size:0.72rem; color:var(--text-muted);">Horas Voluntariado</div><div style="font-size:1.4rem; font-weight:700;">{resumen.horasVoluntariado}h</div></div>
    </div>

    <h3 style="font-size:0.9rem; margin-top:1.4rem;">Desglose de Jornadas y Eventos</h3>
    <table class="tabla-reporte">
      <thead><tr><th>Evento</th><th>Categoría</th><th>Asistencia</th><th>Presupuesto</th></tr></thead>
      <tbody>
        {eventos.map((e) => (
          <tr>
            <td>{e.titulo}<div style="font-size:0.7rem; color:var(--text-muted);">{e.fecha}</div></td>
            <td>{e.categoria}</td>
            <td>{e.asistieron} / {e.convocados}</td>
            <td>${e.presupuestoEjecutado} USD</td>
          </tr>
        ))}
      </tbody>
    </table>

    <h3 style="font-size:0.9rem; margin-top:1.4rem;">Transparencia de Aportes &amp; Donaciones Recibidas</h3>
    <table class="tabla-reporte">
      <thead><tr><th>Recibo</th><th>Donante</th><th>Tipo</th><th>Destino</th><th>Monto</th></tr></thead>
      <tbody>
        {donaciones.map((d) => (
          <tr>
            <td>{d.recibo}</td>
            <td>{d.donante}</td>
            <td>{d.tipo}</td>
            <td>{d.destino}</td>
            <td>+${d.monto} USD</td>
          </tr>
        ))}
      </tbody>
    </table>
  </div>
</Layout>

<style>
  .tabla-reporte { width: 100%; border-collapse: collapse; font-size: 0.8rem; margin-top: 0.6rem; }
  .tabla-reporte th { text-align: left; color: var(--text-muted); font-size: 0.7rem; text-transform: uppercase; padding: 0.5rem 0.4rem; border-bottom: 1px solid var(--card-border); }
  .tabla-reporte td { padding: 0.55rem 0.4rem; border-bottom: 1px solid var(--card-border); }

  /* US-12: estilos de impresión. Sidebar, topbar y titlebar se ocultan desde Layout/TitleBar. */
  .estado-export { font-size: 0.8rem; color: var(--text-muted); min-height: 1.2rem; margin-bottom: 0.6rem; }

  @media print {
    .estado-export { display: none; }
    #reporte { border: none !important; box-shadow: none !important; max-width: none !important; }
  }
</style>

<script>
  import type { ResumenReporte, Evento, Donacion } from "../../lib/mockData";

  interface DatosReporte {
    resumen: ResumenReporte;
    eventos: Evento[];
    donaciones: Donacion[];
  }

  const contenedor = document.getElementById("reporte");
  const estado = document.getElementById("estado-export");
  const datos: DatosReporte | null = contenedor?.dataset.reporte
    ? JSON.parse(contenedor.dataset.reporte)
    : null;

  const esTauri = "__TAURI_INTERNALS__" in window;

  function mostrarEstado(mensaje: string) {
    if (estado) estado.textContent = mensaje;
  }

  // US-11: arma el CSV a partir del mismo mock (sin backend).
  function construirCsv({ resumen, eventos, donaciones }: DatosReporte): string {
    const filas: (string | number)[][] = [
      ["Reporte", resumen.periodo],
      [],
      ["Evento", "Categoria", "Fecha", "Asistieron", "Convocados", "PresupuestoEjecutado"],
      ...eventos.map((e) => [e.titulo, e.categoria, e.fecha, e.asistieron, e.convocados, e.presupuestoEjecutado]),
      [],
      ["Recibo", "Donante", "Tipo", "Destino", "Monto"],
      ...donaciones.map((d) => [d.recibo, d.donante, d.tipo, d.destino, d.monto]),
    ];
    const csv = filas
      .map((fila) => fila.map((v) => `"${String(v).replace(/"/g, '""')}"`).join(","))
      .join("\r\n");
    // BOM al inicio para que Excel muestre bien tildes y ñ.
    return "\uFEFF" + csv;
  }

  // En la ventana de Tauri no funcionan las descargas con <a download>:
  // se abre el diálogo "Guardar como" y se escribe el archivo con los plugins.
  async function guardarConTauri(nombre: string, contenido: string): Promise<boolean> {
    const { save } = await import("@tauri-apps/plugin-dialog");
    const { writeTextFile } = await import("@tauri-apps/plugin-fs");
    const ruta = await save({
      defaultPath: nombre,
      filters: [{ name: "CSV", extensions: ["csv"] }],
    });
    if (!ruta) return false; // la usuaria canceló
    await writeTextFile(ruta, contenido);
    return true;
  }

  // En un navegador normal (pnpm dev:astro) sí funciona la descarga directa.
  function descargarEnNavegador(nombre: string, contenido: string) {
    const blob = new Blob([contenido], { type: "text/csv;charset=utf-8;" });
    const url = URL.createObjectURL(blob);
    const a = document.createElement("a");
    a.href = url;
    a.download = nombre;
    document.body.appendChild(a);
    a.click();
    a.remove();
    setTimeout(() => URL.revokeObjectURL(url), 1000);
  }

  document.getElementById("btn-csv")?.addEventListener("click", async () => {
    if (!datos) return;
    const nombre = `reporte-${datos.resumen.periodo.replace(" ", "-").toLowerCase()}.csv`;
    const contenido = construirCsv(datos);
    try {
      if (esTauri) {
        const guardado = await guardarConTauri(nombre, contenido);
        mostrarEstado(guardado ? `Archivo ${nombre} guardado.` : "Descarga cancelada.");
      } else {
        descargarEnNavegador(nombre, contenido);
        mostrarEstado(`Archivo ${nombre} descargado.`);
      }
    } catch (err) {
      console.error(err);
      mostrarEstado(`No se pudo guardar el archivo: ${err instanceof Error ? err.message : String(err)}`);
    }
  });

  // US-12: imprimir / guardar como PDF con el diálogo del sistema.
  document.getElementById("btn-pdf")?.addEventListener("click", () => {
    window.print();
  });
</script>